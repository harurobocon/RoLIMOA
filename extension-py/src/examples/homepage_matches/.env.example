# RoLIMOA WebSocket URL
ROLIMOA_WS_URL=ws://localhost:8000/ws

# homepage matches update API URL
# ローカルテスト時はDjango開発サーバーのURL (例: http://localhost:8000/staff/matches/api/update/)
HOMEPAGE_API_URL=http://localhost:8001/staff/matches/api/update/

# homepage matches API Token (Django側の GAS_API_TOKEN と一致させる)
HOMEPAGE_API_TOKEN=my_secret_token
